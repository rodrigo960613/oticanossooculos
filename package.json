{
  "name": "nosso-oculos-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page do NossoÓculos — React + HTML + CSS + JavaScript",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --target=es2019 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outdir=dist --entry-names=app",
    "dev": "esbuild src/main.jsx --bundle --sourcemap --jsx=automatic --define:process.env.NODE_ENV=\\\"development\\\" --outdir=dist --entry-names=app --watch --servedir=."
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
